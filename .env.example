# Copy to .env.local. All of these are optional — the site works fully without any of them.

# Canonical site URL, used in metadata and the sitemap. Defaults to
# https://www.bordersoftime.com if unset.
NEXT_PUBLIC_SITE_URL=

# ── Monetization (src/lib/monetization.ts) ──────────────────────────────────
# All optional and off by default; the site behaves exactly as it does today
# until you set one of these.

# Your Ko-fi / Buy Me a Coffee page. When set, SupportButton links straight
# there; when unset, it links to the on-site /support page instead.
NEXT_PUBLIC_SUPPORT_URL=

# Set to "true" to render labeled ad-slot placeholders (see AdSlot.tsx) so you
# can check layout before a real ad network is wired in. Leave unset in
# production until you've actually chosen a network.
NEXT_PUBLIC_ADS_ENABLED=
